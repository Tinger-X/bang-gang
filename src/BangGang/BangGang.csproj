<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BangGang</AssemblyName>
    <AssemblyTitle>帮帮</AssemblyTitle>
    <Product>帮帮</Product>
    <Version>0.9.14</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 编译器警告当错误：这份工程本来就是 0 警告（Nullable 开着、没有 NoWarn），
         这条是把它钉住，免得下次 SDK 或某次手滑悄悄带进来一条没人看见的警告。
         分析器那批 info 级建议不走这里 —— 它们的取舍写在仓库根的 .editorconfig。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 发布：dotnet publish -c Release -r win-x64 -p:PublishSingleFile=true -p:SelfContained=false -->
  </PropertyGroup>

</Project>
